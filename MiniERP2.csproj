<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MiniERP2</RootNamespace>
    <AssemblyName>MiniERP2</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
    <!-- MFG/ = 별도 단독 실행 프로젝트 MiniERP2_MFG(제조원가관리). 이 프로젝트에 섞여 컴파일되지 않게 제외한다. -->
    <Compile Remove="MFG/**" />
    <EmbeddedResource Remove="MFG/**" />
    <None Remove="MFG/**" />
    <Compile Remove="ScrollCapture/**" />
    <EmbeddedResource Remove="ScrollCapture/**" />
    <None Remove="ScrollCapture/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.6.1" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4210" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

</Project>
